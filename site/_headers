# Cabeçalhos do Cloudflare Pages (o GitHub Pages ignora este arquivo)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# o service worker do app precisa ser conferido sempre, para a versão nova chegar
/sw.js
  Cache-Control: no-cache
